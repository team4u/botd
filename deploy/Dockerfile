# ==============================================================================
# Multi-stage Dockerfile for botd monorepo
# Base runtime: Node.js 24 (Debian bookworm slim) + pnpm 10.34.9 via corepack
# ==============================================================================

FROM node:24-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Enable corepack and activate exact required pnpm version
RUN corepack enable && corepack prepare pnpm@10.34.9 --activate

# ==============================================================================
# Stage 1: Builder (Install dependencies & compile all workspace packages)
# ==============================================================================
FROM base AS builder
WORKDIR /app

# Copy all repository source files (filtered strictly by .dockerignore)
COPY . .

# Install dependencies using frozen lockfile generated by root
RUN pnpm install --frozen-lockfile

# Build protocol, hub, node agent, and web SPA frontend
RUN pnpm run build

# ==============================================================================
# Stage 2: Production Runner
# ==============================================================================
FROM base AS runner
WORKDIR /app

# Install runtime dependencies:
# - bash: required by Pi SDK / bot tool execution
# - curl: required for container healthcheck
# - ca-certificates: required for external HTTPS/WSS connections
# - procps: required for process management
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    ca-certificates \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Copy built application and workspace node_modules
COPY --from=builder /app /app

# Set up globally accessible botd CLI wrapper in PATH for wake commands
RUN printf '#!/bin/sh\nexec node /app/apps/node/dist/cli.js "$@"\n' > /usr/local/bin/botd && \
    chmod +x /usr/local/bin/botd

# Install entrypoint script
RUN cp /app/deploy/entrypoint.sh /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/entrypoint.sh

# Default environment configuration
ENV NODE_ENV=production
ENV BOTD_HOST=0.0.0.0
ENV BOTD_PORT=3000
ENV BOTD_DB_PATH=/data/hub.sqlite
ENV BOTD_ADMIN_PASSWORD=admin
ENV BOTD_DATA_DIR=/data/node
ENV PATH="/usr/local/bin:/app/node_modules/.bin:$PATH"

# Ensure persistent mount directories exist
RUN mkdir -p /data/node

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["hub"]
