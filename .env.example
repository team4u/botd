# ==============================================================================
# botd 环境变量配置文件模板 (.env.example)
# 复制此文件为 .env 并按需配置：cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Hub 服务配置 (Control Plane)
# ------------------------------------------------------------------------------
# 服务监听 IP 与端口（生产环境与 Docker 容器内使用 0.0.0.0:3000）
BOTD_HOST=0.0.0.0
BOTD_PORT=3000

# Cloud Hub SQLite 数据库持久化路径（优先使用 BOTD_DB_PATH）
BOTD_DB_PATH=/data/hub.sqlite

# 备选数据目录（当未指定 BOTD_DB_PATH 时，数据库默认存为 ${BOTD_HUB_DATA_DIR}/hub.sqlite）
# BOTD_HUB_DATA_DIR=/data

# Web SPA 静态资源构建产物目录（默认自动查找 apps/web/dist）
# BOTD_WEB_DIR=apps/web/dist

# 自举 admin 账号密码（首次启动创建账号时生效；默认 admin）
BOTD_ADMIN_PASSWORD=admin

# botd CLI 登录 Hub 使用的用户名（默认 admin；密码沿用 BOTD_ADMIN_PASSWORD 或 --password）
# BOTD_USERNAME=admin

# ------------------------------------------------------------------------------
# 2. Node Agent 节点配置
# ------------------------------------------------------------------------------
# 节点独立持久化根目录（本机部署默认使用 ~/.botd，容器内指定为 /data/node）
BOTD_DATA_DIR=/data/node

# ------------------------------------------------------------------------------
# 3. 大模型凭证配置 (API Keys)
# 以下仅为示例；完整供应商目录由 Pi SDK 提供。
# 其他供应商使用 BOTD_API_KEY_<提供商标识大写，并将连字符替换为下划线>。
# 例如 mistral -> BOTD_API_KEY_MISTRAL，zai-coding-cn -> BOTD_API_KEY_ZAI_CODING_CN。
# 优先级：BOTD_API_KEY_<PROVIDER> 环境变量 > 节点本地 ~/.botd/.agent/auth.json
# （Web 节点登录流程写入）；禁止读取宿主 ~/.pi，Hub 不存储任何 Key。
# ------------------------------------------------------------------------------
# Anthropic Claude API Key
# BOTD_API_KEY_ANTHROPIC=your-provider-key

# OpenAI API Key
# BOTD_API_KEY_OPENAI=sk-...

# DeepSeek API Key
# BOTD_API_KEY_DEEPSEEK=sk-...

# Google Gemini API Key
# BOTD_API_KEY_GOOGLE=AIzaSy...

# OpenRouter API Key
# BOTD_API_KEY_OPENROUTER=your-provider-key
