{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "paths": {
      "@botd/protocol": ["../../packages/protocol/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
